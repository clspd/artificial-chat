{
  "name": "artificial-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web:dev": "pnpm -F web dev",
    "web:build": "pnpm -F web build",
    "worker:dev": "pnpm -F worker dev",
    "worker:deploy": "pnpm -F worker deploy",
    "dev": "run-p web:dev worker:dev",
    "build": "pnpm -F web build && pnpm -F worker build",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.3.3"
    },
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
